# Copy this file to ".env" and fill in your real values.
# Read by run_monitor.sh and run_dashboard.sh.

# --- required: Telegram alerts ---
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- optional: publish live data to your public GitHub Pages site (no git) ---
# Leave blank to disable. GITHUB_TOKEN needs "Contents: read & write" on the repo.
GITHUB_TOKEN=
GITHUB_REPO=rushabhddh/temprepo
# GITHUB_BRANCH=main
# PUBLISH_MIN_SECONDS=420      # min seconds between publishes (Pages build limit)
